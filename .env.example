# Frontend (Vite) — safe to expose in the browser
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Edge Function secrets — set via Supabase dashboard or `supabase secrets set`.
# NEVER put these in the frontend env or commit real values.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ENTRY=          (one-time £10 price ID)
# STRIPE_PRICE_CIRCUIT=        (recurring £4.99/mo price ID)
# SITE_URL=                    (public frontend URL, for Stripe redirect URLs)
